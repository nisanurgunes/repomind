# Uygulama
APP_NAME=DevPulse
DEBUG=False

# Veritabanı (Supabase bağlantı URL'si)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis (Railway Redis eklentisinin URL'si)
REDIS_URL=redis://default:password@host:6379

# GitHub OAuth (github.com/settings/applications/new den al)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_github_pat  # opsiyonel, rate limit için

# JWT (uzun rastgele string, örn: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-long-random-string

# Frontend URL (CORS için)
FRONTEND_URL=https://your-app.vercel.app
